# The all-on anchor: every public capability leaf enabled. Used by the
# all-features CI job (via -D SDKCONFIG_DEFAULTS) and by
# `tools/flag-matrix.sh --device` for its all-on combination.
#
# Internal plumbing flags (DRIVER_I2C/UART/GPIO, NET_WIFI, PROTO_V2) are not
# listed — Kconfig selects them from the leaves.

CONFIG_CLUBINS_CAP_SENSOR_DECIBEL=y
CONFIG_CLUBINS_CAP_SENSOR_PAX=y
CONFIG_CLUBINS_CAP_SENSOR_BME280=y
CONFIG_CLUBINS_CAP_SENSOR_SHT4X=y
CONFIG_CLUBINS_CAP_SENSOR_SCD4X=y
CONFIG_CLUBINS_CAP_SENSOR_PMS5003=y
CONFIG_CLUBINS_CAP_SENSOR_BH1750=y
CONFIG_CLUBINS_CAP_TRANSPORT_HTTP=y
CONFIG_CLUBINS_CAP_TRANSPORT_MQTT=y
CONFIG_CLUBINS_CAP_TRANSPORT_MTLS=y
CONFIG_CLUBINS_CAP_OTA=y
CONFIG_CLUBINS_CAP_PROVISIONING=y
CONFIG_CLUBINS_CAP_DEEP_SLEEP=y
CONFIG_CLUBINS_CAP_LOGGING_DEFMT=y
CONFIG_CLUBINS_CAP_OPS_STATUS=y
